{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@oh-my-pi/pi-tui": ["./talk/types/pi-tui.d.ts"],
      "@oh-my-pi/pi-tui/text/width": ["./talk/types/pi-tui/text/width.d.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/cli",
          "effect/Terminal",
          "effect/FileSystem#layerNoop",
          "effect/Path#layer",
          "@effect/platform-bun/BunRuntime#runMain",
          "@effect/platform-bun/BunServices#layer"
        ]
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "talk/**/*.ts",
    "../SoT/.omp/plugin/extensions/*.ts"
  ]
}
