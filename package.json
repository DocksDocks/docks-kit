{
  "name": "docks-kit",
  "version": "0.29.7",
  "description": "Portable AI coding agent config kit — SoT sync engine + typed CLI for Oh My Pi",
  "type": "module",
  "license": "MIT",
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocksDocks/docks-kit.git"
  },
  "bin": {
    "docks-kit": "cli/dist/docks-kit.js"
  },
  "files": [
    "cli/src",
    "cli/dist/docks-kit.js",
    "cli/docs",
    "cli/tsconfig.json",
    "docks-kit",
    "docks-kit.ps1",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "bun check --no-script -b -p cli",
    "build:bundle": "bun cli/scripts/build-bundle.ts",
    "smoke:package": "bun cli/scripts/package-smoke.ts",
    "check:generated": "bun cli/scripts/generate-sot-payload.ts --check",
    "prepack": "bun run check:generated && bun run build:bundle",
    "golden:dryrun": "bun cli/test/golden-dryrun.ts",
    "golden:mutation": "bun cli/test/golden-mutation.ts",
    "test:unit": "vitest run",
    "test:unit:portable": "vitest run --project unit --project backstop",
    "test:ci": "bun run check:generated && bun run --parallel typecheck test:unit:portable golden:dryrun golden:mutation format:check",
    "test:integration": "bun run --parallel golden:dryrun golden:mutation",
    "test": "bun run --parallel test:unit test:integration",
    "lint": "oxlint",
    "lint:effect": "effect-tsgo diagnostics --project cli/tsconfig.json --strict --format text",
    "format": "bun fmt --no-script cli/src cli/test cli/scripts vitest.config.ts",
    "format:check": "bun fmt --no-script --check cli/src cli/test cli/scripts vitest.config.ts",
    "check": "bun run --parallel lint lint:effect format:check typecheck check:generated test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node-shared": "4.1.5",
    "effect": "4.1.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@types/bun": "1.4.5",
    "fast-check": "4.11.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
